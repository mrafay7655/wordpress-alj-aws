packages:
  yum:
    amazon-efs-utils: []

files:
  "/etc/php.d/99-custom.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 64M
      post_max_size = 64M
      memory_limit = 256M
      max_execution_time = 300

commands:
  01_mount_efs:
    command: |
      set -ex

      EFS_ID=$(/opt/elasticbeanstalk/bin/get-config environment -k EFS_ID_PROD_MACHINERY)

      mkdir -p /mnt/efs

      # Mount only if not already mounted (avoids errors on app-only redeploys)
      if ! mountpoint -q /mnt/efs; then
        mount -t efs -o tls ${EFS_ID}:/ /mnt/efs
      fi

      mount | grep efs

container_commands:
  01_ensure_efs_uploads_dir:
    command: |
      set -ex
      mkdir -p /mnt/efs/wp-content/uploads
      chown -R webapp:webapp /mnt/efs/wp-content/uploads

  02_remove_bundled_wp_content_symlink:
    command: |
      set -ex
      # If a previous manual step left wp-content itself symlinked to EFS, remove that
      if [ -L "wp-content" ]; then
        rm -f wp-content
      fi

  03_remove_bundled_uploads_if_present:
    command: |
      set -ex
      # Your deployed bundle's own wp-content/uploads (if any) is replaced by the EFS symlink
      if [ -d "wp-content/uploads" ] && [ ! -L "wp-content/uploads" ]; then
        rm -rf wp-content/uploads
      fi

  04_symlink_uploads_to_efs:
    command: |
      set -ex
      if [ ! -L "wp-content/uploads" ]; then
        ln -s /mnt/efs/wp-content/uploads wp-content/uploads
      fi

  05_fix_permissions:
    command: |
      set -ex
      chown -R webapp:webapp wp-content

  06_update_php_fpm:
    command: |
      sed -i 's/^pm =.*/pm = dynamic/' /etc/php-fpm.d/www.conf
      sed -i 's/^pm.max_children.*/pm.max_children = 32/' /etc/php-fpm.d/www.conf
      sed -i 's/^pm.start_servers.*/pm.start_servers = 8/' /etc/php-fpm.d/www.conf
      sed -i 's/^pm.min_spare_servers.*/pm.min_spare_servers = 4/' /etc/php-fpm.d/www.conf
      sed -i 's/^pm.max_spare_servers.*/pm.max_spare_servers = 12/' /etc/php-fpm.d/www.conf
      sed -i 's/^pm.max_requests.*/pm.max_requests = 500/' /etc/php-fpm.d/www.conf
      systemctl restart php-fpm